{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding shop-by-room">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin text-{{ section.settings.heading_alignment }}">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="collection__description rte" style="margin-top: 0.8rem; color: #5C5A52;">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="shop-by-room__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="room-card" {{ block.shopify_attributes }}>
          <div class="room-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="600"
                height="660"
              >
            {%- else -%}
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <img src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600&auto=format&fit=crop&q=80" alt="Salón" loading="lazy" width="600" height="660">
                {%- when 2 -%}
                  <img src="https://images.unsplash.com/photo-1617806118233-18e1de247200?w=600&auto=format&fit=crop&q=80" alt="Comedor" loading="lazy" width="600" height="660">
                {%- when 3 -%}
                  <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=600&auto=format&fit=crop&q=80" alt="Dormitorio" loading="lazy" width="600" height="660">
                {%- when 4 -%}
                  <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&auto=format&fit=crop&q=80" alt="Terraza & Jardín" loading="lazy" width="600" height="660">
                {%- when 5 -%}
                  <img src="https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?w=600&auto=format&fit=crop&q=80" alt="Recibidor" loading="lazy" width="600" height="660">
                {%- else -%}
                  <img src="https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=600&auto=format&fit=crop&q=80" alt="Despacho" loading="lazy" width="600" height="660">
              {%- endcase -%}
            {%- endif -%}
          </div>
          <div class="room-card__content">
            <h3 class="room-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.count_text != blank -%}
              <span class="room-card__count">{{ block.settings.count_text }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comprar por Estancia",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Comprar por Estancia",
      "label": "Título"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Piezas concebidas para transformar los espacios de tu vida cotidiana",
      "label": "Subtítulo"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Mediano" },
        { "value": "h1", "label": "Grande" }
      ],
      "default": "h2",
      "label": "Tamaño de título"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left",
      "label": "Alineación"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Estancia",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de estancia"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Salón",
          "label": "Nombre de la estancia"
        },
        {
          "type": "text",
          "id": "count_text",
          "default": "Ver colección",
          "label": "Texto secundario / Conteo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace a colección"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comprar por Estancia",
      "blocks": [
        { "type": "room", "settings": { "title": "Salón", "count_text": "Sofás, mesas y sillones" } },
        { "type": "room", "settings": { "title": "Comedor", "count_text": "Mesas de roble y sillas" } },
        { "type": "room", "settings": { "title": "Dormitorio", "count_text": "Camas, mesitas y lino" } },
        { "type": "room", "settings": { "title": "Terraza & Exterior", "count_text": "Madera de acacia y teca" } },
        { "type": "room", "settings": { "title": "Recibidor", "count_text": "Consolas, bancos y espejos" } },
        { "type": "room", "settings": { "title": "Despacho", "count_text": "Escritorios y almacenaje" } }
      ]
    }
  ]
}
{% endschema %}
