{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding home-inspiration">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin text-{{ section.settings.heading_alignment }}">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="collection__description rte" style="margin-top: 0.8rem; color: #5C5A52;">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="home-inspiration__grid">
      {%- for block in section.blocks -%}
        <div class="inspiration-card" {{ block.shopify_attributes }}>
          <div class="inspiration-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="800"
                height="1000"
              >
            {%- else -%}
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=800&auto=format&fit=crop&q=80" alt="Inspiración Salón" loading="lazy" width="800" height="1000">
                {%- when 2 -%}
                  <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=800&auto=format&fit=crop&q=80" alt="Inspiración Comedor" loading="lazy" width="800" height="1000">
                {%- else -%}
                  <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=800&auto=format&fit=crop&q=80" alt="Inspiración Dormitorio" loading="lazy" width="800" height="1000">
              {%- endcase -%}
            {%- endif -%}
          </div>
          <div class="inspiration-card__info">
            {%- if block.settings.tag != blank -%}
              <span class="inspiration-card__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            <h3 class="inspiration-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.link_text != blank -%}
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="inspiration-card__link">
                {{ block.settings.link_text }} &rarr;
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Inspiración Hogar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Inspiración para el Hogar",
      "label": "Título"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Historias visuales y combinaciones de interiorismo para inspirar tu casa",
      "label": "Subtítulo"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Mediano" },
        { "value": "h1", "label": "Grande" }
      ],
      "default": "h2",
      "label": "Tamaño de título"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left",
      "label": "Alineación"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "inspiration",
      "name": "Idea de Estilo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fotografía editorial"
        },
        {
          "type": "text",
          "id": "tag",
          "default": "Espacios Diáfanos",
          "label": "Etiqueta"
        },
        {
          "type": "text",
          "id": "title",
          "default": "La calidez del roble y la luz dorada",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "link_text",
          "default": "Comprar el look",
          "label": "Texto del enlace"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inspiración Hogar",
      "blocks": [
        {
          "type": "inspiration",
          "settings": {
            "tag": "Salón Minimal",
            "title": "Texturas en lino natural y maderas nobles",
            "link_text": "Ver piezas de este ambiente"
          }
        },
        {
          "type": "inspiration",
          "settings": {
            "tag": "Comedor de Autor",
            "title": "Mesa extensible y sillas en fibras trenzadas",
            "link_text": "Ver comedor completo"
          }
        },
        {
          "type": "inspiration",
          "settings": {
            "tag": "Rincón de Lectura",
            "title": "Butaca escultórica con iluminación indirecta",
            "link_text": "Explorar selección"
          }
        }
      ]
    }
  ]
}
{% endschema %}
