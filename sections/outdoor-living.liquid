{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="med-feature-split" style="flex-direction: row-reverse;">
      <div class="med-feature-split__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="med-feature-split__eyebrow" style="color: var(--color-med-accent-secondary);">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="med-feature-split__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="med-feature-split__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div>
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--primary" style="background-color: var(--color-med-accent-secondary) !important; border-color: var(--color-med-accent-secondary) !important;">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
      <div class="med-feature-split__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.title | escape }}"
            loading="lazy"
            width="800"
            height="600"
          >
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1540541338287-41700207dee6?w=1000&auto=format&fit=crop&q=80"
            alt="Vida en el Exterior"
            loading="lazy"
            width="800"
            height="600"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vida en el Exterior",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Terraza, Balcón & Porche",
      "label": "Subtítulo superior"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Vida en el Exterior: El Clima Mediterráneo",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Muebles de exterior confeccionados en maderas de teca y acacia certificada, cuerdas trenzadas resistentes a los rayos UV y tejidos hidrófugos para vivir el aire libre todo el año.</p>",
      "label": "Descripción"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen principal"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Ver Colección Exterior",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Vida en el Exterior"
    }
  ]
}
{% endschema %}
