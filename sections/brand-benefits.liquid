{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="brand-benefits section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="brand-benefits__grid">
    {%- for block in section.blocks -%}
      <div class="brand-benefit-item" {{ block.shopify_attributes }}>
        <div class="brand-benefit-item__icon">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            {%- when 'leaf' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
            {%- when 'heart' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
          {%- endcase -%}
        </div>
        <div>
          <h3 class="brand-benefit-item__title">{{ block.settings.title }}</h3>
          <p class="brand-benefit-item__description">{{ block.settings.description }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ventajas de Marca",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Ventaja",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "truck", "label": "Camión de envío" },
            { "value": "shield", "label": "Escudo de garantía" },
            { "value": "leaf", "label": "Hoja ecológica" },
            { "value": "heart", "label": "Corazón de confianza" }
          ],
          "default": "truck",
          "label": "Icono"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Envío a Península y Baleares",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "description",
          "default": "Entrega cuidada y gratuita a partir de 60€ de compra.",
          "label": "Descripción"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ventajas de Marca",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "Envío a Península y Baleares",
            "description": "Entrega rápida y gratuita a partir de 60€ de compra."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "3 Años de Garantía Oficial",
            "description": "Compromiso de solidez y durabilidad en cada pieza."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Madera Sostenible FSC",
            "description": "Maderas de bosques gestionados responsablemente."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "title": "Devolución en 30 Días",
            "description": "Pruébalo en casa sin compromiso con devolución fácil."
          }
        }
      ]
    }
  ]
}
{% endschema %}
