{%- comment -%}
  Renders core selling points and highlights on Product Detail Page
  Uses product.metafields.custom.product_highlights when available,
  or standard Mediterranean Living brand values.
{%- endcomment -%}

{%- liquid
  assign highlights = product.metafields.custom.product_highlights.value | default: product.metafields.custom.product_highlights
-%}

<div class="pdp-highlights-bar">
  <div class="pdp-highlight-item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path></svg>
    <span>Materiales nobles sostenibles</span>
  </div>
  <div class="pdp-highlight-item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
    <span>Envío peninsular 48-72h</span>
  </div>
  <div class="pdp-highlight-item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    <span>3 años de garantía oficial</span>
  </div>
  <div class="pdp-highlight-item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
    <span>30 días de prueba en casa</span>
  </div>
</div>

{%- if highlights != blank -%}
  <div class="product__text subtitle rte" style="margin-top: 1rem; color: #4A473E;">
    {{ highlights }}
  </div>
{%- endif -%}
