{%- comment -%}
  Renders payment reassurance, payment badges, and installment messaging
  on the Product Detail Page.
{%- endcomment -%}

<div class="pdp-payment-reassurance">
  <div class="pdp-payment-reassurance__title">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
    <span>Pago Seguro y Métodos de Confianza</span>
  </div>
  <p style="font-size: 1.25rem; color: #5C5A52; margin: 0 0 1rem 0;">
    Paga en <strong>3 plazos sin intereses con Klarna</strong> o utiliza tu tarjeta con cifrado bancario SSL 256-bit.
  </p>
  <div class="pdp-payment-badges">
    <span class="pdp-payment-badge">Klarna 3 plazos</span>
    <span class="pdp-payment-badge">Bizum</span>
    <span class="pdp-payment-badge">Visa</span>
    <span class="pdp-payment-badge">Mastercard</span>
    <span class="pdp-payment-badge">Apple Pay</span>
    <span class="pdp-payment-badge">PayPal</span>
  </div>
</div>
