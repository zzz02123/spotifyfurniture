{%- comment -%}
  Renders product dimensions, materials, assembly, and shipping notes
  based on product metafields:
  - custom.material
  - custom.width
  - custom.height
  - custom.depth
  - custom.weight
  - custom.assembly_required
  - custom.shipping_note

  Guards against empty/blank fields: does not output empty rows or an empty container.
{%- endcomment -%}

{%- liquid
  assign material = product.metafields.custom.material.value | default: product.metafields.custom.material
  assign width = product.metafields.custom.width.value | default: product.metafields.custom.width
  assign height = product.metafields.custom.height.value | default: product.metafields.custom.height
  assign depth = product.metafields.custom.depth.value | default: product.metafields.custom.depth
  assign weight = product.metafields.custom.weight.value | default: product.metafields.custom.weight
  assign assembly = product.metafields.custom.assembly_required.value | default: product.metafields.custom.assembly_required
  assign shipping_note = product.metafields.custom.shipping_note.value | default: product.metafields.custom.shipping_note

  assign has_dimensions = false
  if width != blank or height != blank or depth != blank
    assign has_dimensions = true
  endif

  assign has_any_spec = false
  if material != blank or has_dimensions or weight != blank or assembly != blank or shipping_note != blank
    assign has_any_spec = true
  endif
-%}

{%- if has_any_spec -%}
  <div class="product__accordion accordion quick-add-hidden">
    <details id="Details-Specs-{{ section.id }}" open>
      <summary>
        <div class="summary__title">
          <span class="svg-wrapper" style="color: var(--color-med-accent-primary); display: inline-flex; align-items: center; margin-right: 0.8rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </span>
          <h2 class="h4 accordion__title inline-richtext">
            Especificaciones y Medidas
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte">
        <table class="pdp-specs-table">
          <tbody>
            {%- if material != blank -%}
              <tr>
                <th>Materiales</th>
                <td>{{ material }}</td>
              </tr>
            {%- endif -%}

            {%- if has_dimensions -%}
              <tr>
                <th>Dimensiones (Al x An x Pr)</th>
                <td>
                  {%- if height != blank -%}{{ height }}{%- else -%}&mdash;{%- endif %} x
                  {% if width != blank %}{{ width }}{%- else -%}&mdash;{%- endif %} x
                  {% if depth != blank %}{{ depth }}{%- else -%}&mdash;{%- endif -%}
                </td>
              </tr>
            {%- endif -%}

            {%- if weight != blank -%}
              <tr>
                <th>Peso neto</th>
                <td>{{ weight }}</td>
              </tr>
            {%- endif -%}

            {%- if assembly != blank -%}
              <tr>
                <th>Montaje</th>
                <td>{{ assembly }}</td>
              </tr>
            {%- endif -%}

            {%- if shipping_note != blank -%}
              <tr>
                <th>Información de entrega</th>
                <td>{{ shipping_note }}</td>
              </tr>
            {%- endif -%}
          </tbody>
        </table>
      </div>
    </details>
  </div>
{%- endif -%}
